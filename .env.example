# Copy this file to .env.local (dev) and .env.production (deploy).
# Values come from Firebase Console → Project Settings → Your apps → SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fran-gc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fran-gc
VITE_FIREBASE_STORAGE_BUCKET=fran-gc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "1" during local development to connect to the emulator suite.
# Leave empty (or unset) for production.
VITE_USE_EMULATORS=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXX).
# If empty, analytics are disabled.
VITE_GA_MEASUREMENT_ID=
