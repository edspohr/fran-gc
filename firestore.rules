rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'francisca@spohr.cl',
        'edmundo@spohr.cl',
        'edmundo@growthbuddies.cl'
      ];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function clientDoc(uid) {
      return get(/databases/$(database)/documents/clients/$(uid)).data;
    }

    match /products/{productId} {
      allow read: if resource.data.visible == true;
      allow list: if true;

      allow create, update, delete: if isAdmin()
        && request.resource.data.keys().hasAll([
          'name','slug','category','description','presentation',
          'unitType','tags','featured','visible','order',
          'createdAt','updatedAt'
        ]);
    }

    match /clients/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.status == 'por-verificar'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == uid;

      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name','company','comuna','phone','rut','address','updatedAt']));

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow list: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.clientId);

      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && clientDoc(request.auth.uid).status == 'activo'
        && request.resource.data.status in ['borrador','confirmado']);

      allow update: if isAdmin() || (isSignedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'borrador'
        && request.resource.data.status in ['borrador','confirmado']
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['items','deliveryDate','notes','status','statusHistory','updatedAt']));

      allow delete: if isAdmin();
    }

    match /counters/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.next == 2;
      allow update: if isSignedIn() && request.resource.data.next == resource.data.next + 1;
    }

    match /mail/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (isSignedIn() && (
             request.resource.data.to.hasOnly([
               'francisca@spohr.cl','edmundo@spohr.cl','edmundo@growthbuddies.cl'
             ])
             || request.resource.data.to == [request.auth.token.email]
           ));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
